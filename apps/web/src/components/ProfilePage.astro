---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  createPublicClient,
  fetchProfile,
  fetchProfilePosts,
} from "../publicApi.js";

const { username } = Astro.props;

const client = createPublicClient();
const profile = await fetchProfile(client, username);
const postsPage = profile ? await fetchProfilePosts(client, username) : null;
const posts = postsPage?.results ?? [];
const displayName = profile?.display_name ?? username;

function postAlt(post) {
  if (post.caption) {
    return post.caption;
  }
  return `Фото ${displayName}`;
}
---

<BaseLayout title={displayName}>
  <div class="pk-column">
  <p><a href="/">На главную</a></p>

  {
    profile ? (
      <header>
        {profile.avatar ? <img src={profile.avatar} alt="" width="96" height="96" /> : null}
        <h1>{displayName}</h1>
        {profile.bio ? <p>{profile.bio}</p> : null}
      </header>
    ) : (
      <p>Профиль не найден.</p>
    )
  }

  {
    profile && posts.length > 0 ? (
      <ul class="pk-profile-posts">
        {posts.map((post) => (
          <li>
            <figure>
              {post.image ? (
                <img
                  src={post.image}
                  alt={postAlt(post)}
                  width={post.width ?? undefined}
                  height={post.height ?? undefined}
                  loading="lazy"
                />
              ) : null}
              {post.caption ? <figcaption>{post.caption}</figcaption> : null}
            </figure>
          </li>
        ))}
      </ul>
    ) : null
  }
  </div>
</BaseLayout>
