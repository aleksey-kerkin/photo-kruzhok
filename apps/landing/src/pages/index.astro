---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import { DEMO_USERNAMES } from "../demoUsers.js";
import { createPublicClient } from "../publicApi.js";

const client = createPublicClient();
let posts = [];
try {
  const page = await client.request("/api/posts");
  posts = Array.isArray(page?.results) ? page.results : [];
} catch {
  posts = [];
}
---

<BaseLayout title="Фото-кружок">
  <h1 class="pk-column">Фото-кружок</h1>
  <h2>Витрина</h2>
  <ul class="pk-grid">
    {
      posts.map((post) => (
        <li class="pk-grid__item">
          <a href={`/posts/${post.id}`}>
            <img src={post.image} alt={post.caption || `Фото ${post.id}`} width={post.width} height={post.height} />
          </a>
        </li>
      ))
    }
  </ul>
  <ul>
    {
      DEMO_USERNAMES.map((username) => (
        <li>
          <a href={`/profiles/${username}`}>{username}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
