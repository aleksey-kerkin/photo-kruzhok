---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import { DEMO_USERNAMES } from "../demoUsers.js";
import { createPublicClient, fetchProfile } from "../publicApi.js";

const webAppUrl = import.meta.env.PUBLIC_WEB_APP_URL ?? "http://localhost:5173";
const client = createPublicClient();
const profiles = await Promise.all(
  DEMO_USERNAMES.map(async (username) => {
    const profile = await fetchProfile(client, username);
    return {
      username,
      label: profile?.display_name ?? username,
    };
  }),
);

const showcaseItems = [
  { alt: "Пример кадра 1" },
  { alt: "Пример кадра 2" },
  { alt: "Пример кадра 3" },
];
---

<BaseLayout title="Фото-кружок">
  <header>
    <h1>Фото-кружок</h1>
    <p>
      <a href={webAppUrl}>Открыть приложение</a>
    </p>
  </header>

  <section>
    <h2>Витрина</h2>
    <ul class="landing-showcase">
      {
        showcaseItems.map((item, index) => (
          <li>
            <img
              src="/showcase.svg"
              alt={item.alt}
              width="320"
              height="240"
              {...(index === 0
                ? { fetchpriority: "high" }
                : { loading: "lazy" })}
            />
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>Анонсы</h2>
    <p>Анонсы появятся здесь, когда API подключён к сборке.</p>
  </section>

  <section>
    <h2>Профили</h2>
    <ul class="landing-profiles">
      {
        profiles.map(({ username, label }) => (
          <li>
            <a href={`/profiles/${username}`}>{label}</a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
