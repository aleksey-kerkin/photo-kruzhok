---
const { id, label, error, invalid = false, class: className, ...inputProps } = Astro.props;
const fieldClass = ["pk-field", invalid || error ? "pk-field--invalid" : null, className]
  .filter(Boolean)
  .join(" ");
const errorId = error ? `${id}-error` : undefined;
---

<div class={fieldClass}>
  <label class="pk-field__label" for={id}>{label}</label>
  <input
    id={id}
    class="pk-field__control"
    aria-invalid={invalid || Boolean(error) || undefined}
    aria-describedby={errorId}
    {...inputProps}
  />
  {error ? <p class="pk-field__error" id={errorId} role="alert">{error}</p> : null}
</div>
