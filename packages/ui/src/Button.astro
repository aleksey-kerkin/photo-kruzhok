---
const { variant, class: className, type = "button", ...rest } = Astro.props;
const classes = ["pk-button", variant === "primary" ? "pk-button--primary" : null, className]
  .filter(Boolean)
  .join(" ");
---

<button class={classes} type={type} {...rest}>
  <span class="pk-button__label"><slot /></span>
</button>
