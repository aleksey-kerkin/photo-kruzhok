---
const { title, open = false, dialogId = `pk-dialog-${Math.random().toString(36).slice(2)}`, class: className, ...rest } =
  Astro.props;
const classes = ["pk-dialog", className].filter(Boolean).join(" ");
---

<dialog id={dialogId} class={classes} open={open || undefined} {...rest}>
  <div class="pk-dialog__panel">
    {title ? <h2 class="pk-dialog__title">{title}</h2> : null}
    <div class="pk-dialog__body">
      <slot />
    </div>
  </div>
</dialog>

<script type="module" define:vars={{ dialogId, open }}>
  import { trapFocus } from "./focusTrap.js";

  const dialog = document.getElementById(dialogId);
  if (!dialog) {
    return;
  }

  let releaseFocus = null;

  const observer = new MutationObserver(() => {
    syncOpen(dialog.hasAttribute("open"));
  });

  function observeOpen() {
    observer.observe(dialog, { attributes: true, attributeFilter: ["open"] });
  }

  function syncOpen(isOpen) {
    observer.disconnect();

    releaseFocus?.();
    releaseFocus = null;

    if (isOpen) {
      if (!dialog.matches(":modal")) {
        dialog.removeAttribute("open");
        dialog.showModal();
      }
      const panel = dialog.querySelector(".pk-dialog__panel");
      releaseFocus = trapFocus(panel ?? dialog);
      observeOpen();
      return;
    }

    if (dialog.open) {
      dialog.close();
    }

    observeOpen();
  }

  function handleClose() {
    releaseFocus?.();
    releaseFocus = null;
  }

  dialog.addEventListener("close", handleClose);

  syncOpen(open);
</script>
